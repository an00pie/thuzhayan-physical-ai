ACCELEROMETER_ENDPOINT_URL=http://localhost:8000/pad
FC_ENDPOINT_URL=http://localhost:8000/flight-controller
ACCELEROMETER_USE_MOCK_DATA=true
ACCELEROMETER_POLL_INTERVAL_SECONDS=0.1
ACCELEROMETER_MAX_POINTS=300
ACCELEROMETER_MATPLOTLIB_BACKEND=QtAgg

# Comma-separated ESP32 clock-sync endpoints. Failures are ignored until they exist.
CLOCK_SYNC_ENDPOINT_URLS=http://esp32-1/sync-clock,http://esp32-2/sync-clock
CLOCK_SYNC_INTERVAL_SECONDS=30

# Mock ESP32 clock drift in parts per million; mock sync never sends HTTP requests.
MOCK_CLOCK_DRIFT_PPM=80
MOCK_PADDLE_COUNT=3

# Minimum plausible time between paddle-stroke troughs.
TROUGH_MIN_DISTANCE_SECONDS=0.6
